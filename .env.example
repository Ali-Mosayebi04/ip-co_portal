# PostgreSQL
POSTGRES_DB=ipco_db
POSTGRES_USER=ipco_user
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Django database connection
DB_HOST=db
DB_PORT=5432

# Django
# Use $$ instead of $ in values when using Docker Compose (e.g. secret keys).
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Set when serving over HTTPS behind a reverse proxy
USE_HTTPS=False
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Email (used to send meeting-room booking invitations to employees).
# In development, leave DJANGO_EMAIL_BACKEND unset — emails print to the
# console instead of actually sending. In production, set it to
# django.core.mail.backends.smtp.EmailBackend and fill in the SMTP
# details below.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=پورتال ایران خودرو <no-reply@example.com>

# Optional
WEB_PORT=8000
