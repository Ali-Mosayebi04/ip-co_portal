# PostgreSQL
POSTGRES_DB=ipco_db
POSTGRES_USER=ipco_user
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Django database connection
DB_HOST=db
DB_PORT=5432

# Django
# Use $$ instead of $ in values when using Docker Compose (e.g. secret keys).
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Set when serving over HTTPS behind a reverse proxy
USE_HTTPS=False
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Optional
WEB_PORT=8000
